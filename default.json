{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shareable Renovate preset: born-mergeable PRs (release-age gated), weekly grouped non-major automerge, minimal CI churn.",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 3,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Non-major updates automerge once CI is green",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Majors need a human review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "automerge": true,
    "labels": [
      "security"
    ]
  }
}
