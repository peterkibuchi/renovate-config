{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shareable Renovate preset: born-mergeable PRs (release-age gated), weekly grouped non-major automerge, minimal CI churn.",
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "schedule": [
    "before 6am"
  ],
  "prConcurrentLimit": 3,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Prod deps (non-major): grouped daily, automerge on green",
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "prod non-major",
      "automerge": true
    },
    {
      "description": "Dev/tooling deps (non-major): grouped daily, automerge on green",
      "matchDepTypes": [
        "devDependencies",
        "peerDependencies",
        "optionalDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "dev non-major",
      "automerge": true
    },
    {
      "description": "Majors are individual and human-reviewed",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "automerge": true,
    "labels": [
      "security"
    ]
  }
}